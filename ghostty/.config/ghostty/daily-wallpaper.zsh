#!/bin/zsh
# Invoked by interactive Ghostty shells; select at most once per calendar day.
emulate -LR zsh
setopt extendedglob
export LC_ALL=C

wallpaper_dir="${WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
output="$HOME/.config/ghostty/daily-wallpaper.ghostty"
state="$HOME/.config/ghostty/daily-wallpaper.state"
images=("$wallpaper_dir"/(#i)*.(png|jpg|jpeg)(N-.))

# Leave the last working configuration intact if no images are available.
if (( ! ${#images} )); then
  exit 0
fi
mkdir -p "${output:h}" || exit 1

# Serialize simultaneous shell startups; the OS releases the lock on exit.
zmodload zsh/system || exit 1
: >> "${state}.lock" || exit 1
zsystem flock -t 5 -f lock_fd "${state}.lock" || exit 1

day=$(date +%F)
last_day=''
[[ -f "$state" ]] && IFS= read -r last_day < "$state"
[[ "$last_day" == "$day" && -f "$output" ]] && exit 0

# Read the actual current selection, including the pre-migration background.
previous=''
if [[ -f "$output" ]]; then
  while IFS= read -r line; do
    [[ "$line" == 'background-image = '* ]] && previous=${line#background-image = }
  done < "$output"
fi
candidates=()
for image in "${images[@]}"; do
  [[ "${image:t}" != "${previous:t}" ]] && candidates+=("$image")
done
# With only one image there is no distinct alternative.
(( ${#candidates} )) || candidates=("${images[@]}")
image=${candidates[$(( RANDOM % ${#candidates} + 1 ))]}

tmp=$(mktemp "${output}.XXXXXX") || exit 1
state_tmp=$(mktemp "${state}.XXXXXX") || { rm -f -- "$tmp"; exit 1; }
trap 'rm -f -- "$tmp" "$state_tmp"' EXIT
{
  print -r -- '# Generated by daily-wallpaper.zsh; edit the script, not this file.'
  print -r -- "background-image = $image"
} > "$tmp" || exit 1
print -r -- "$day" > "$state_tmp" || exit 1
changed=0
if [[ ! -f "$output" ]] || ! cmp -s "$tmp" "$output"; then
  mv -f -- "$tmp" "$output" || exit 1
  changed=1
fi
mv -f -- "$state_tmp" "$state" || exit 1

# Reload running Ghostty windows after selecting a new background.
if (( changed )) && [[ "$1" != --no-reload ]]; then
  /usr/bin/pkill -USR2 -u "$UID" -x ghostty 2>/dev/null || true
fi
